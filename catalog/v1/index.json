{
  "schemaVersion": 1,
  "plugins": [
    {
      "manifest": {
        "schemaVersion": 1,
        "format": "compiled",
        "id": "lexora.auto-title",
        "name": "标题自动生成",
        "author": "XTLaw",
        "description": "根据首条有效输入自动生成任务标题，保留手动命名，也可随任务目标变化更新。",
        "version": "1.3.0",
        "apiVersion": 3,
        "engines": {
          "lexora": ">=0.2.0 <1.0.0"
        },
        "entry": "extension.js",
        "icon": "icon.svg",
        "categories": [
          "效率"
        ],
        "tags": [
          "任务标题",
          "自动命名",
          "AI"
        ],
        "permissions": {
          "agent": true,
          "models": true,
          "tasks": "title",
          "taskMessages": true
        },
        "contributes": {
          "settings": {
            "groups": [
              {
                "id": "lexora.auto-title.naming",
                "module": "settings.runtime",
                "title": "标题自动生成"
              }
            ],
            "items": [
              {
                "id": "lexora.auto-title.enabled",
                "key": "enabled",
                "group": "lexora.auto-title.naming",
                "type": "boolean",
                "title": "启用",
                "description": "仅对启用后创建的新任务，在主回复开始后后台命名；内容不足或失败时可在下次输入时重试。",
                "default": true,
                "order": 0
              },
              {
                "id": "lexora.auto-title.model",
                "key": "model",
                "group": "lexora.auto-title.naming",
                "type": "model",
                "title": "生成标题的模型",
                "description": "留空使用触发任务当前选择的模型。",
                "default": null,
                "order": 1,
                "enabledWhen": {
                  "condition": "lexora.auto-title.available",
                  "params": {
                    "purpose": "configure"
                  }
                }
              },
              {
                "id": "lexora.auto-title.update-on-goal-change",
                "key": "updateOnGoalChange",
                "group": "lexora.auto-title.naming",
                "type": "boolean",
                "title": "允许随任务目标更新",
                "description": "每轮回答后额外调用模型评估，仅在任务目标明显变化时更新自动标题。手动标题始终保留。",
                "default": false,
                "order": 2,
                "enabledWhen": {
                  "condition": "lexora.auto-title.available",
                  "params": {
                    "purpose": "configure"
                  }
                }
              }
            ]
          },
          "agent": {
            "enabledWhen": "enabled",
            "actions": [
              {
                "id": "lexora.auto-title.generate",
                "title": "重新生成标题",
                "triggers": [
                  "task:created",
                  "task:reply:started",
                  "task:turn:completed"
                ],
                "execution": "background"
              }
            ]
          },
          "conditions": [
            {
              "id": "lexora.auto-title.available",
              "inputs": [
                "configuration",
                "form"
              ]
            }
          ]
        }
      },
      "iconUrl": "data:image/svg+xml;base64,",
      "repository": "https://github.com/QAyong/xtlaw-market",
      "artifact": {
        "url": "https://github.com/QAyong/xtlaw-market/releases/download/auto-title-v1.3.0/auto-title-1.3.0.lexora-extension",
        "sha256": "57e03ad0c43ed9a1b79a2869ea1c3b3dcf6c8ca210c44d471074b96de8c7d3b3",
        "size": 5248
      }
    },
    {
