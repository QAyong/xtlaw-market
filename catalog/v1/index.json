      "iconUrl": "data:image/svg+xml;base64,",
      "repository": "https://github.com/QAyong/xtlaw-plugins",
      "artifact": {
        "url": "https://github.com/QAyong/xtlaw-plugins/releases/download/office-v0.1.7/office-0.1.7.lexora-extension",
        "sha256": "55419a1b19018d296f77d0860a616abb016b680af1420caa1348e29ec82dda88",
        "size": 12408125
