            {
              "id": "pd2ec0b9018e6402d8ada6873f7fa8721.office.document",
              "title": "Office DOCX",
              "entry": "view.js",
              "resource": "selected-file",
              "accepts": {
                "extensions": [
                  "docx"
                ]
              },
              "location": "context"
            }
          ]
